[TEMPLATE]
# Google Earth Engine project ID (required).
#
# 1. Register at https://code.earthengine.google.com/register (noncommercial
#    tier for research/personal use) and register/select a Cloud project.
# 2. Copy this file to backend/.env and set the project ID below.
GEE_PROJECT_ID=your-earth-engine-project-id

# ---------------------------------------------------------------------------
# AI chat providers (Phase 2 — optional; /api/chat is disabled without them)
# ---------------------------------------------------------------------------
# The chat bot uses an OpenAI-compatible fallback chain: first provider with
# a key wins; on rate-limit/timeout it moves to the next. All free tiers.
# NOTE (privacy): prompts are processed by these third parties — fine for
# public satellite data, but documented (see docs/METHODOLOGY.md §9).
#
# 1. Groq — https://console.groq.com/keys (fastest; put it first)
GROQ_API_KEY=
#    Model to use (free-tier names rotate; check console)
GROQ_MODEL=llama-3.3-70b-versatile
#
# 2. Google AI Studio — https://aistudio.google.com/apikey
#    (OpenAI-compatible endpoint: generativelanguage.googleapis.com)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
#
# 3. OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
